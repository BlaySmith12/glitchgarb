# ============================================================
# GlitchGarb VPS - environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# NOTE: Never commit the real .env to git.
# ============================================================

# --- PostgreSQL (used by docker-compose to create the db) ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- API / JWT ---
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REFRESH_EXPIRE_DAYS=30

# --- Site ---
FRONTEND_URL=https://glitchgarb.com
ENV=production
LOGO_URL=https://glitchgarb.com/logo.png

# --- Email (Resend recommended) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=GlitchGarb

# --- SMTP alternative (only if not using Resend) ---
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# --- Payments ---
PAYSTACK_SECRET_KEY=sk_test_xxx

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://glitchgarb.com/api/auth/google/callback
