PORT=5001
DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REFRESH_EXPIRE_DAYS=30
FRONTEND_URL=https://glitchgarb.com
ENV=production

# Email provider: 'resend' (HTTPS API, works on Render free tier) or 'smtp' (requires paid tier)
# If not set, auto-detects: prefers Resend if RESEND_API_KEY is set, else SMTP if credentials are set
EMAIL_PROVIDER=resend

# Resend config (recommended for Render free tier)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=GlitchGarb

# SMTP config (alternative — requires Render paid tier since free tier blocks SMTP ports)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

PAYSTACK_SECRET_KEY=sk_test_xxx
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-api.onrender.com/api/auth/google/callback
